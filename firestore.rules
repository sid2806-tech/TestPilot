rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ────────────────────────────────────────────────────────────────
    // Users can only read/write their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Projects ─────────────────────────────────────────────────────────────
    // Projects are only accessible by their owner.
    match /projects/{projectId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId;
    }

    // ─── Test Runs ────────────────────────────────────────────────────────────
    match /testRuns/{runId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
      allow write: if false; // Backend-only writes via Admin SDK

      // Sub-collections — events and test cases
      match /events/{eventId} {
        allow read: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/testRuns/$(runId)).data.ownerId;
        allow write: if false;
      }
      match /testCases/{caseId} {
        allow read: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/testRuns/$(runId)).data.ownerId;
        allow write: if false;
      }
    }

    // ─── Bug Reports ──────────────────────────────────────────────────────────
    match /bugReports/{bugId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
      allow write: if false;
    }

    // ─── Default deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
