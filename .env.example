# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ---- Google Gemini ----
GEMINI_API_KEY=AIzaSyDiA8P0hGgGJHsMl9Us48D_NjGcJeD49Bk

# ---- Firebase Admin SDK ----
# Option A: Path to downloaded service-account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
# Option B: Inline JSON (for Cloud Run secrets)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---- Firebase Web Config (frontend) ----
VITE_FIREBASE_API_KEY=AIzaSyD-iSOHA_LvL_uuu-xNf_Ot_Gjl2ksfKrQ
VITE_FIREBASE_AUTH_DOMAIN=testpilot-cefb3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=testpilot-cefb3
VITE_FIREBASE_STORAGE_BUCKET=testpilot-cefb3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=666905821057
VITE_FIREBASE_APP_ID=1:666905821057:web:7775ed1163f8ef61683280
VITE_FIREBASE_MEASUREMENT_ID=G-N98XC83XJB

# ---- Backend ----
BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=/api/v1

# ---- Google Cloud ----
GCS_BUCKET_NAME=your-gcs-bucket-name
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ---- Security ----
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Execution Limits ----
MAX_TEST_TIMEOUT_SECONDS=120
MAX_CONCURRENT_RUNS=3
MAX_STEPS_PER_RUN=50

# ---- Demo ----
DEMO_BUG_ENABLED=true
