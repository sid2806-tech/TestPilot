# =============================================
# TestPilot AI — Environment Variables Example
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ---- Google Gemini ----
GEMINI_API_KEY=your-gemini-api-key-here

# ---- Firebase Admin SDK ----
# Option A: Path to downloaded service-account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
# Option B: Inline JSON (for Cloud Run secrets)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---- Firebase Web Config (frontend) ----
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ---- Backend ----
BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---- Google Cloud ----
GCS_BUCKET_NAME=your-gcs-bucket-name
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ---- Security ----
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Execution Limits ----
MAX_TEST_TIMEOUT_SECONDS=120
MAX_CONCURRENT_RUNS=3
MAX_STEPS_PER_RUN=50

# ---- Demo ----
DEMO_BUG_ENABLED=true
